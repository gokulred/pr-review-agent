# LLM keys: set at least one. Groq is tried first, Gemini is the fallback.
GROQ_API_KEY=
GEMINI_API_KEY=
# Fine-grained GitHub token. Read-only on public repos is enough for reviews;
# posting comments also needs "Pull requests: Read and write" on the allowed repos.
GITHUB_TOKEN=
# Repos the Streamlit app may review (and post to), comma-separated.
ALLOWED_REPOS=gokulred/review-sandbox
# Show the "Post comments to GitHub" button. Leave unset on a public demo.
# ENABLE_POSTING=1
# Or, for local use only, allow any repo:
# ALLOW_ANY_REPO=1
# Optional model overrides (free-tier model names change often)
# GROQ_MODEL=openai/gpt-oss-120b
# GEMINI_MODEL=gemini-3.8-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite   (tried in order)
